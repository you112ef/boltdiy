{
	"name": "boltdiy",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"format": "biome format --write",
		"lint:fix": "biome lint --fix",
		"start": "wrangler dev",
		"cf-typegen": "wrangler types",
		"type-check": "tsc --noEmit",
		"build": "npm run build:copy && npm run build:optimize",
		"build:copy": "echo 'Static files already in public directory'",
		"build:optimize": "npm run build:minify || echo 'Minification skipped'",
		"build:minify": "node scripts/minify.js || echo 'Minify script not found'",
		"preview": "npm run dev",
		"pages:dev": "wrangler pages dev public",
		"pages:deploy": "wrangler pages deploy public --project-name boltdiy-agent-platform",
		"pages:build": "npm run build && npm run pages:deploy"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.12.1",
		"agents": "^0.0.94",
		"zod": "^3.25.51"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"typescript": "^5.8.3",
		"wrangler": "^4.19.1"
	}
}
