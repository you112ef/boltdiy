{
	"name": "boltdiy",
	"version": "0.0.0",
	"private": true,
	"packageManager": "pnpm@8.15.0",
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"format": "biome format --write",
		"lint:fix": "biome lint --fix",
		"start": "wrangler dev",
		"cf-typegen": "wrangler types",
		"type-check": "tsc --noEmit",
		"build": "npm run build:clean && npm run build:copy && npm run build:finalize",
		"build:clean": "rm -rf build/client && mkdir -p build/client",
		"build:copy": "cp -r public/* build/client/",
		"build:finalize": "echo 'Build completed successfully in build/client'",
		"preview": "pnpm run dev",
		"pages:dev": "wrangler pages dev build/client",
		"pages:deploy": "wrangler pages deploy build/client --project-name boltdiy-agent-platform",
		"pages:build": "pnpm run build && pnpm run pages:deploy"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.12.1",
		"agents": "^0.0.94",
		"zod": "^3.25.51"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"typescript": "^5.8.3",
		"wrangler": "^4.19.1"
	}
}
